   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "# =========================================================\n",
    "# LOAD BACTERIAL DENSITY DATA\n",
    "# =========================================================\n",
    "\n",
    "file_path = r\"F:\\Analysis_Divya_Fluorescent_bacteria_CFU-20260601T025607Z-3-001\\Analysis_Divya_Fluorescent_bacteria_CFU\\Final values\\Merged files\\Final Compiled normalised bacterial  density per unit intestinal volume.xlsx\"\n",
    "\n",
    "df = pd.read_excel(file_path)\n",
    "\n",
    "# =========================================================\n",
    "# CALCULATE MEAN AND SD OF BACTERIAL DENSITY\n",
    "# =========================================================\n",
    "\n",
    "mean_density = df.mean()\n",
    "sd_density = df.std()\n",
    "\n",
    "# =========================================================\n",
    "# PA14 CFU REPLICATE DATA\n",
    "# =========================================================\n",
    "\n",
    "cfu_replicates = {\n",
    "    'Day 1': [11, 11],\n",
    "    'Day 2': [27, 32],\n",
    "    'Day 3': [27, 24]\n",
    "}\n",
    "\n",
    "# Mean CFU\n",
    "mean_cfu = {\n",
    "    day: np.mean(values)\n",
    "    for day, values in cfu_replicates.items()\n",
    "}\n",
    "\n",
    "# =========================================================\n",
    "# MATCH DAYS\n",
    "# =========================================================\n",
    "\n",
    "days = ['Day 1', 'Day 2', 'Day 3']\n",
    "\n",
    "density_values = [mean_density[day] for day in days]\n",
    "density_errors = [sd_density[day] for day in days]\n",
    "\n",
    "cfu_values = [mean_cfu[day] for day in days]\n",
    "\n",
    "# =========================================================\n",
    "# SPEARMAN CORRELATION\n",
    "# =========================================================\n",
    "\n",
    "corr, p = spearmanr(density_values, cfu_values)\n",
    "\n",
    "# =========================================================\n",
    "# COLORS\n",
    "# =========================================================\n",
    "\n",
    "purple = '#9A0EEA'\n",
    "light_black = (0, 0, 0, 0.4)\n",
    "\n",
    "# =========================================================\n",
    "# CREATE PLOT\n",
    "# =========================================================\n",
    "\n",
    "plt.figure(figsize=(7,6))\n",
    "\n",
    "# Y-axis error bars only (density SD)\n",
    "plt.errorbar(\n",
    "    cfu_values,\n",
    "    density_values,\n",
    "    yerr=density_errors,\n",
    "    fmt='none',\n",
    "    ecolor=light_black,\n",
    "    elinewidth=1.5,\n",
    "    capsize=5,\n",
    "    capthick=1.5,\n",
    "    zorder=1\n",
    ")\n",
    "\n",
    "# Scatter points\n",
    "plt.scatter(\n",
    "    cfu_values,\n",
    "    density_values,\n",
    "    s=120,\n",
    "    color=purple,\n",
    "    edgecolors='black',\n",
    "    linewidths=1.2,\n",
    "    zorder=2\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# LABELS\n",
    "# =========================================================\n",
    "\n",
    "plt.xlabel(\n",
    "    ' ',\n",
    "    fontsize=12\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    ' ',\n",
    "    fontsize=12\n",
    ")\n",
    "\n",
    "# =========================================================\n",
    "# TICK LABELS\n",
    "# =========================================================\n",
    "\n",
    "# X-axis (CFU per worm)\n",
    "xticks = [0, 5,10, 15, 20, 25, 30, 35]\n",
    "plt.xticks(xticks, [''] * len(xticks))\n",
    "\n",
    "# Y-axis (bacterial density)\n",
    "yticks = [0.0000, 0.0025, 0.0050, 0.0075, 0.0100, 0.0125, 0.0150,0.0175]\n",
    "plt.yticks(\n",
    "    yticks,\n",
    "    [''] * len(yticks)\n",
    ")\n",
    "\n",
    "plt.savefig(\n",
    "    r'F:\\Analysis_Divya_Fluorescent_bacteria_CFU-20260601T025607Z-3-001\\CFU CORRELATION GRAPH WITH FLUORESCENT BACTERIA-PA14.tiff',\n",
    "    dpi=300,\n",
    "    format='tiff',\n",
    "    bbox_inches='tight'\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "# =========================================================\n",
    "# SHOW PLOT\n",
    "# =========================================================\n",
    "\n",
    "plt.show()\n"
   ]
